    "editor.visibleAreaHint" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Prozentwerte beziehen sich auf den sichtbaren Bereich ohne Dock und Menüleiste." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Percentages use the visible area excluding the Dock and menu bar." } } } },
    "editor.width" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Breite" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Width" } } } },
    "empty.description" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Wähle ein Preset aus oder erstelle ein neues." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Select a preset or create a new one." } } } },
    "empty.title" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein Preset ausgewählt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No Preset Selected" } } } },
    "error.accessibilityFailure" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "macOS konnte das Fenster nicht ändern." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS could not modify the window." } } } },
    "error.cannotMove" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Fenster kann nicht verschoben werden." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This window cannot be moved." } } } },
    "error.cannotResize" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Fenster kann nicht skaliert werden." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This window cannot be resized." } } } },
    "error.fullScreen" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Vollbildfenster werden nicht verändert." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Full-screen windows are not modified." } } } },
    "error.hotkey.duplicate" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser Kurzbefehl wird bereits von einem anderen Preset verwendet." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Another preset already uses this shortcut." } } } },
    "error.hotkey.modifier" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Verwende mindestens Command, Option oder Control." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Use at least Command, Option, or Control." } } } },
    "error.hotkey.registration" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "macOS oder eine andere App reserviert diesen Kurzbefehl." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS or another app reserves this shortcut." } } } },
    "error.hotkey.reserved" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser macOS-Standardkurzbefehl kann nicht überschrieben werden." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This standard macOS shortcut cannot be overridden." } } } },
    "error.invalidPreset" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Preset enthält ungültige Werte oder hat keine Wirkung." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The preset contains invalid values or has no effect." } } } },
    "error.noActiveApplication" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine aktive App gefunden." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "No active app was found." } } } },
    "error.noFocusedWindow" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die aktive App hat kein fokussiertes Fenster." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The active app has no focused window." } } } },
    "error.ownWindow" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Arson verändert sein eigenes Fenster nicht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Arson does not modify its own window." } } } },
    "error.permissionRequired" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Erlaube Arson unter „Gerätesteuerung und Datenzugriff“ in den Systemeinstellungen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Arson in Device Control & Data Access in System Settings." } } } },
    "error.screenNotFound" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Bildschirm des Fensters konnte nicht ermittelt werden." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The window's screen could not be determined." } } } },
    "error.store.schema" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Preset-Datei verwendet die nicht unterstützte Version %lld." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The preset file uses unsupported version %lld." } } } },
    "error.unsupportedWindow" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Element ist kein unterstütztes Fenster." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This element is not a supported window." } } } },
    "hotkey.accessibilityLabel" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Globalen Kurzbefehl aufnehmen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Record global shortcut" } } } },
    "hotkey.none" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Keiner" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "None" } } } },
    "hotkey.recording" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kurzbefehl drücken…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Press shortcut…" } } } },
    "menu.openArson" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Arson öffnen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Arson" } } } },
    "menu.preset" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Preset" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Preset" } } } },
    "menu.quit" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Arson beenden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Quit Arson" } } } },
    "menu.showIntroduction" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Einführung anzeigen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Show Introduction" } } } },
    "onboarding.allow" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Bedienungshilfen erlauben" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Accessibility" } } } },
    "onboarding.back" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Zurück" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Back" } } } },
    "onboarding.continue" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Weiter" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue" } } } },
    "onboarding.description" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Bringe das fokussierte Fenster mit eigenen globalen Kurzbefehlen auf genau die Größe und Position, die du brauchst." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Use your own global shortcuts to give the focused window exactly the size and position you need." } } } },
    "onboarding.getStarted" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Loslegen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Get Started" } } } },
    "onboarding.later" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Später" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Later" } } } },
    "onboarding.done" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Fertig" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } } } },
    "onboarding.permissionDescription" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Damit Arson Fenster anderer Apps skalieren und bewegen kann, musst du die App einmal in macOS freigeben." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "To resize and move other apps' windows, Arson needs to be allowed once in macOS." } } } },
    "onboarding.permissionFallback" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Ist Arson nicht aufgeführt, füge die aktuell gestartete Arson.app über „+“ hinzu. Steht der Schalter bereits auf „Ein“, der Status bleibt aber „Nicht erlaubt“, entferne den alten Eintrag mit „–“ und füge Arson erneut hinzu. Auf älteren macOS-Versionen heißt der Bereich „Bedienungshilfen“." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "If Arson is not listed, use “+” to add the currently running Arson.app. If its switch is already on but the status remains Not Allowed, remove the stale entry with “–” and add Arson again. On older macOS versions, this section is called Accessibility." } } } },
    "onboarding.permissionPrivacy" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Arson verwendet die Freigabe ausschließlich lokal zur Fenstersteuerung." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Arson uses this permission locally and only for window control." } } } },
    "onboarding.permissionPath" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Systemeinstellungen › Datenschutz & Sicherheit › Gerätesteuerung und Datenzugriff" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "System Settings › Privacy & Security › Device Control & Data Access" } } } },
    "onboarding.permissionRationaleTitle" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Fenster anderer Apps steuern" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Control Other App Windows" } } } },
    "onboarding.permissionReadyDescription" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Fenstersteuerung ist freigegeben. Du kannst deine Presets jetzt überall verwenden." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Window control is enabled. You can now use your presets anywhere." } } } },
    "onboarding.permissionReadyTitle" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Arson ist bereit" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Arson Is Ready" } } } },
    "onboarding.permissionReason" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Freigabe wird ausschließlich für die Fenstersteuerung verwendet" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Permission is used only for window control" } } } },
    "onboarding.permissionStep1" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Klicke unten auf „Zugriff anfordern“." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Click “Request Access” below." } } } },
    "onboarding.permissionStep2" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Wähle im macOS-Hinweis „Systemeinstellungen öffnen“." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose “Open System Settings” in the macOS prompt." } } } },
    "onboarding.permissionStep3" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiviere dort den Schalter neben „Arson“." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on the switch next to Arson." } } } },
    "onboarding.permissionStep4" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kehre zu Arson zurück und klicke auf „Erneut prüfen“." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Return to Arson and click “Check Again”." } } } },
    "onboarding.permissionTitle" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Fenstersteuerung erlauben" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Window Control" } } } },
    "onboarding.permissionTroubleshooting" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Probleme bei der Freigabe?" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Having Trouble?" } } } },
    "onboarding.permissionWaitingDescription" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiviere Arson unter „Gerätesteuerung und Datenzugriff“. Arson erkennt die Freigabe automatisch." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on Arson under Device Control & Data Access. Arson detects the permission automatically." } } } },
    "onboarding.permissionWaitingStatus" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Warte auf Freigabe …" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for permission…" } } } },
    "onboarding.permissionWaitingTitle" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Arson in den Systemeinstellungen aktivieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Arson in System Settings" } } } },
    "onboarding.presets" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Größe und Position in Presets kombinieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Combine size and position in presets" } } } },
    "onboarding.shortcuts" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Presets überall mit globalen Kurzbefehlen ausführen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Run presets anywhere with global shortcuts" } } } },
    "onboarding.title" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Willkommen bei Arson" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome to Arson" } } } },
