    "settings.menuBarBackgroundHelp" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Ohne Menüleistensymbol läuft Arson mit seinen globalen Kurzbefehlen vollständig im Hintergrund weiter. Öffne Arson erneut, um das Fenster zurückzubringen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Without a menu bar icon, Arson and its global shortcuts continue running entirely in the background. Open Arson again to restore the window." } } } },
