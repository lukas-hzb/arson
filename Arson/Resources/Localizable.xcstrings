    "editor.offsetHint" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Positive X-Werte verschieben nach rechts, positive Y-Werte nach unten. Der Bildschirmrand begrenzt den Versatz nicht." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Positive X values move right and positive Y values move down. Offsets are not constrained to the screen." } } } },
