    "settings.languageHelp" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Arson ist auf Deutsch und Englisch verfügbar. Die App-Sprache wird in den Systemeinstellungen festgelegt; Änderungen gelten nach dem erneuten Öffnen von Arson." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Arson is available in English and German. Choose the app language in System Settings; changes take effect after reopening Arson." } } } },
