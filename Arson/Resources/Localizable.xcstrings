    "editor.pointAreaHint" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Punktwerte werden auf die sichtbare Größe des Bildschirms begrenzt." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Point values are limited to the visible screen size." } } } },
    "editor.position" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Position" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Position" } } } },
