    "editor.shortcutHint" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Klicke auf das Feld und drücke den gewünschten Kurzbefehl. Escape bricht ab, Löschen entfernt ihn." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Click the field and press a shortcut. Escape cancels and Delete clears it." } } } },
